# Runtime configuration, not account credentials. Byte values are integers.
VAULT_SYNC_PORT=8080
VAULT_SYNC_IMAGE=native-vault-sync:local
VAULT_SYNC_MAX_STORAGE_BYTES=10737418240
VAULT_SYNC_DEFAULT_USER_STORAGE_BYTES=10737418240
VAULT_SYNC_MAX_FILE_BYTES=208666624
VAULT_SYNC_MAX_VAULTS=10
VAULT_SYNC_SESSION_DAYS=30
VAULT_SYNC_MAX_CONNECTIONS=64
VAULT_SYNC_USER_CONNECTIONS=8
VAULT_SYNC_MAX_UPLOADS=16
VAULT_SYNC_USER_UPLOADS=4
VAULT_SYNC_LOGIN_CONCURRENCY=2
VAULT_SYNC_MEMORY_LIMIT=1g
VAULT_SYNC_CPUS=2
# Set ONLY to explicit CIDRs of the actual reverse-proxy peers.
VAULT_SYNC_TRUSTED_PROXIES=
# Optional absolute host paths; pre-create and chown to UID:GID 10001:10001.
# VAULT_SYNC_DATA_MOUNT=/srv/vault-sync/data
# VAULT_SYNC_CONFIG_MOUNT=/srv/vault-sync/config
# VAULT_SYNC_BACKUP_MOUNT=/srv/vault-sync/backups
