# Root-owned, mode 0600. Do not commit real credentials.
VAULT_SYNC_BACKUP_MODE=systemd
VAULT_SYNC_BACKUP_ROOT=/var/backups/vault-sync
VAULT_SYNC_CONFIG=/etc/vault-sync/config.json
RESTIC_REPOSITORY=/mnt/offsite-backups/vault-sync-restic
RESTIC_PASSWORD_FILE=/etc/vault-sync/restic-password
# Compose mode additionally uses the same directory/project as your deployment:
# VAULT_SYNC_SOURCE_DIR=/opt/native-vault-sync
# COMPOSE_PROJECT_NAME=vault-sync
# Plain Docker mode:
# VAULT_SYNC_CONTAINER=vault-sync
